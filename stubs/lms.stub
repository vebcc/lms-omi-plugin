<?php

// Minimalne sygnatury klas i funkcji LMS używanych przez plugin - wyłącznie dla PHPStan.
// Rozszerzenie .stub (nie .php), żeby classmap composera LMS-a nigdy ich nie załadował.

abstract class LMSPlugin
{
    /** @var array<string, array{class: string, method: string}> */
    protected $handlers;

    /** @return void */
    abstract public function registerHandlers();
}

class LMSDB
{
    public const RESOURCE_TYPE_TABLE = 1;

    /** @return LMSDB_common */
    public static function getInstance($force_new = false) {}
}

class LMSDB_common
{
    /**
     * @param array<mixed>|null $inputarray
     * @return array<int, array<string, mixed>>|null
     */
    public function GetAll($query = null, ?array $inputarray = null) {}

    /**
     * @param array<mixed>|null $inputarray
     * @return array<string, mixed>|null
     */
    public function GetRow($query = null, ?array $inputarray = null) {}

    /**
     * @param array<mixed>|null $inputarray
     * @return mixed
     */
    public function GetOne($query = null, ?array $inputarray = null) {}

    /**
     * @param array<mixed>|null $inputarray
     * @return int|false
     */
    public function Execute($query, ?array $inputarray = null) {}

    /** @return bool */
    public function ResourceExists($name, $type) {}

    /** @return void */
    public function BeginTrans() {}

    /** @return void */
    public function CommitTrans() {}
}

